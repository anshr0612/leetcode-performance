/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
ListNode* reverseKGroup(ListNode* head, int k) {
ListNode dummy(0, head);
ListNode* prev = &dummy;
while (1) {  
        ListNode* end = prev;  
        for (int i = 0; i < k && end; i++) end = end->next;  
        if (!end) break;  
        ListNode *cur = prev->next, *nxt = cur->next, *stop = end->next;  
        while (nxt != stop) {  
            cur->next = nxt->next;  
            nxt->next = prev->next;  
            prev->next = nxt;  
            nxt = cur->next;  
        }  
        prev = cur;  
    }  
    return dummy.next;  
}
};
