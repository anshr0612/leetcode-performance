class Solution {
public:
    int divide(int dividend, int divisor) {
       if(dividend == INT_MIN && divisor==-1)return INT_MAX;
        long long dvd=abs((long long) dividend);
        long long dvs=abs((long long) divisor);
        long int ans=0;
        while(dvd>=dvs){
            long long temp=dvs;
            int multiple=1;
            while((temp<<1)<=dvd){
                temp<<=1;
                multiple<<=1;
            }
            dvd-=temp;
            ans+=multiple;
        }
        if(dividend<0 ^ divisor<0)return -ans;
        else return ans;
    }
};
