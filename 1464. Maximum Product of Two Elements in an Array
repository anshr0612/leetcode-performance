class Solution {
public:
    int maxProduct(vector<int>& nums) {
        int n=nums.size();
       /* sort(nums.begin(),nums.end());
        return((nums[n-1]-1)*(nums[n-2]-1));
        */
        int a=0,b=0;
        for(int i=0;i<n;i++){
            if(a<=nums[i]){
                b=a;
                a=nums[i];
            }else if(b<=nums[i]){
                b=nums[i];
            }
        }
        return((a-1)*(b-1));
    }
};
